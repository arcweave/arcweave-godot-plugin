# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Only include the addons folder when downloading from the Asset Library.
/**        export-ignore
/addons    !export-ignore
/addons/** !export-ignore

# Sample data and saved credentials from older versions, which the plugin doesn't use.
/addons/arcweave/data.json export-ignore
/addons/arcweave/data.save export-ignore
